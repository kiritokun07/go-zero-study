syntax = "v1"

info(
	title: "demo"
	author: "kirito"
	email: "504831261@qq.com"
)

type (
	LoginReq {
		Username string `json:"username"`
		Password string `json:"password"`
	}

	LoginResp {
	}
)

@server(
	prefix: demo
	group: user
)
service demo-api {
	@doc "login"
	@handler Login
	post / (LoginReq) returns (LoginResp)
}